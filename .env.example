# Server-only Gemini API key. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key

# Optional model override. The alias tracks an available Flash-Lite model.
GEMINI_MODEL=gemini-flash-lite-latest

# Server-only GitHub token used by /api/github. Add this to your deployment environment.
GITHUB_TOKEN=

# Public LeetCode profile name used by the server-side activity endpoint.
LEETCODE_USERNAME=
